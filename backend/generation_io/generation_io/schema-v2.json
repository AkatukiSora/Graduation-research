  "count_fields": [
    "source_rows",
    "excluded_non_stop",
    "rejected_stop",
    "outside_region",
    "normalized_points",
    "candidate_rows"
  ],
  "count_aliases": {
    "rows_total": "counts.source_rows",
    "candidate_rows": "counts.candidate_rows"
  },
  "schemas": {
    "normalized_points": [
      "entity_id", "region_id", "source_row", "selected_field_sha256", "source_month",
      "prefecture", "raw_uid", "record_id", "jartic_record_id", "ユニークキー",
