    "status",
    "input_kind",
    "counts",
    "rows_total",
    "candidate_rows",
    "production_approved",
    "source_active_status",
    "identity_scope",
    "parameters",
    "boundary",
    "provenance",
    "schemas",
    "schema",
    "parent_refs",
    "code_refs",
    "runtime",
    "outputs",
    "excluded_claims"
  ],
  "manifest_optional_fields": [
    "resume"
