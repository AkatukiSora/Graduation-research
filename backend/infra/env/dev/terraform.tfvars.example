aws_region          = "ap-northeast-3"
# aws_profile       = "your-profile"
name_prefix         = "gr9-dev"
database_name       = "gr9_dev"
master_username     = "gr9admin"
app_db_user         = "gr9app"
ecr_repository_name = "gr9-backend-app"
app_image_uri       = "012751249662.dkr.ecr.ap-northeast-3.amazonaws.com/gr9-backend-app:latest"

# Aurora Serverless v2 の MinCapacity=0 は engine version / region の組み合わせに依存します。
# 利用中リージョンで 0 が未対応なら 0.5 以上に変更してください。
serverless_min_acu       = 0
serverless_max_acu       = 2
seconds_until_auto_pause = 900

lambda_memory_size    = 256
lambda_timeout        = 15
migration_task_cpu    = 256
migration_task_memory = 512

tags = {
  Project     = "gr9"
  Environment = "dev"
  ManagedBy   = "Terraform"
  Repository  = "NKC-CV2026/Graduation-research"
}
